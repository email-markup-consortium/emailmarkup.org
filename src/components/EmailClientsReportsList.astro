---
let posts = Object.values(import.meta.glob([
  '../pages/en/reports/email-clients/*.{md,mdx}',
  '!../pages/en/reports/email-clients/index.mdx',
], { eager: true }));
posts = posts
.filter(post => !post.file.endsWith('index.mdx'));
---

<ul>
  {posts.map(post => (
    <li>
      <a href={post.url}>
        {post.frontmatter.title}
      </a>
    </li>
  ))}
</ul>
